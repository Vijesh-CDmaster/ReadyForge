# Root-level copy for local development (server also reads server/.env)
# --- Server ---
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Leave MONGODB_URI empty to auto-start a persistent local in-memory MongoDB
# (data stored under server/.data/mongo). Set a real URI for production.
MONGODB_URI=

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- AI layer (OpenAI-compatible) ---
# Works without a key: ReadyForge falls back to its deterministic rule engine
# and labels results as "rule engine" instead of "AI".
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Uploads ---
MAX_UPLOAD_MB=25

# --- Video generation (mock is the safe offline default) ---
VIDEO_PROVIDER=mock
RUNWAY_API_KEY=
RUNWAY_BASE_URL=https://api.dev.runwayml.com
RUNWAY_MODEL=gen4.5
RUNWAY_ESTIMATED_COST_USD=0
VIDEO_MAX_COST_USD=0
VIDEO_COST_CURRENCY=USD
VIDEO_PROVIDER_TIMEOUT_MS=30000
VIDEO_POLL_INITIAL_MS=2000
VIDEO_POLL_MAX_MS=15000
